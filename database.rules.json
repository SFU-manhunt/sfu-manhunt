{
  "rules": {
    "devices": {
      "$dev": {
        ".read": "auth != null",
        ".write": "auth != null && $dev.length <= 32 && $dev.matches(/^[A-Za-z0-9_-]+$/)"
      }
    },
    "games": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.child('hostUid').val() === auth.uid",

        "hostUid":   { ".validate": true },
        "createdAt": { ".validate": true },
        "state": {
          ".write": "auth != null && data.parent().child('hostUid').val() === auth.uid",
          ".validate": "newData.val() === 'lobby' || newData.val() === 'running' || newData.val() === 'ended'"
        },
        "startedAt": { ".write": "auth != null && data.parent().child('hostUid').val() === auth.uid" },
        "endedAt":   { ".write": "auth != null && data.parent().child('hostUid').val() === auth.uid" },
        "winner":    { ".write": "auth != null && data.parent().child('hostUid').val() === auth.uid" },
        "seekerUid": { ".write": "auth != null && data.parent().child('hostUid').val() === auth.uid" },
        "config":    { ".write": "auth != null && data.parent().child('hostUid').val() === auth.uid" },

        "players": {
          "$uid": {
            ".write": "auth != null && ((auth.uid === $uid && (data.exists() || root.child('games').child($code).child('state').val() === 'lobby')) || root.child('games').child($code).child('hostUid').val() === auth.uid)",
            ".validate": "newData.child('name').isString() && newData.child('name').val().length <= 24"
          }
        },

        "powerups": {
          "$id": {
            ".write": "auth != null && (root.child('games').child($code).child('hostUid').val() === auth.uid || !newData.exists())"
          }
        },

        "tags": {
          "$hider": {
            ".write": "auth != null && (auth.uid === $hider || auth.uid === root.child('games').child($code).child('seekerUid').val())"
          }
        },

        "$other": { ".validate": false }
      }
    }
  }
}
